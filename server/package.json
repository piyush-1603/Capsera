{
  "name": "capsera-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CAPSERA Backend REST API (Node.js + Express + PostgreSQL)",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "check": "node --check src/index.js && node --check src/app.js && node --check src/config/db.js",
    "seed:admin": "node scripts/seed-admin.js",
    "test": "vitest run",
    "test:integration": "RUN_PG_INTEGRATION=true DB_NAME=capsera_cp03_test vitest run tests/skills.integration.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.3.1"
  }
}
