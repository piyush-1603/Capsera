# Server Environment Example
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database (Required by Faculty; see docs/DECISIONS.md — ADR-002)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=capsera_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_CONNECTION_LIMIT=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000
# Optional full connection URI override:
# DATABASE_URL=postgresql://postgres:your_postgres_password_here@127.0.0.1:5432/capsera_db

# Auth secrets (Member 1 auth decisions)
JWT_SECRET=replace_with_a_strong_random_secret_in_local_env
JWT_EXPIRES_IN=1h
BCRYPT_COST=12

# Admin seed credentials (Member 1 user governance)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_secure_admin_password
ADMIN_FULL_NAME=System Administrator
